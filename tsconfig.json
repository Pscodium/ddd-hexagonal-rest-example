{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "./src",
    "outDir": "./dist",
    "typeRoots": ["src/types", "./node_modules/@types", "src/shared/types"], 
    "paths": {
      "@/*": ["*"]
    },
  },
  "include": ["tests", "tests/**/*", "jest.config.js", "src/types"],
  "exclude": ["node_modules", "dist", "tests/__mocks__"]
}